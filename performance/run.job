#! /bin/bash
#SBATCH -p q_thesis
#SBATCH -N 31
#SBATCH --ntasks-per-node=22
#SBATCH --cpu-freq=High
#SBATCH --job-name=AllgatherLibs
#SBATCH --time=1:00:00

mkdir ../data/AllgatherLibs

rm ../data/AllgatherLibs/31x22intelMPI.txt
echo MPIlib: intelMPI
module load mpi/intelmpi
make perf
for i in {1..30}; do
    srun ../build/executeExperimentRuns.o runs.json >> ../data/AllgatherLibs/31x22intelMPI.txt
echo iteration $i
done
module unload mpi/intelmpi

echo finished
