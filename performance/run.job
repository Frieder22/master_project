#! /bin/bash
#SBATCH -p q_thesis
#SBATCH -N 32
#SBATCH --ntasks-per-node=1
#SBATCH --cpu-freq=High
#SBATCH --job-name=UnionCritSize
#SBATCH --time=1:00:00

mkdir ../data/UnionCritSize

rm ../data/UnionCritSize/32x1MPICH.txt
echo MPIlib: MPICH
module unload mpi/intelmpi
make perf
for i in {1..30}; do
    mpirun ../build/executeExperimentRuns.o runs.json >> ../data/UnionCritSize/32x1MPICH.txt
echo iteration $i
done
module unload mpi/intelmpi

echo finished
